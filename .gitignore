__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/

# Never commit credentials
.env
.env.*

# Personal assistant runtime state
data/*.db
data/*.db-shm
data/*.db-wal
data/backups/
data/drill_evidence/
data/research_reports/
data/locks/
# Elevated epoch-swap helper output. These files are machine-local evidence;
# preserve them on the host, but never let them dirty the frozen checkout.
data/swap_*_result_*.json

# Machine-local runtime artifacts (AP-2, ACTION_PLAN 2026-08-02). The
# documented operational commands write inside the repository -- the
# runbook's supervisor/shadow invocations use artifacts/shadow.json,
# artifacts/model/, artifacts/ml-*.json, and the experiment CLI documents
# artifacts/{datasets,experiments,reviews}/. Two reasons the whole
# directory is ignored:
#   1. licensed vendor data (artifacts/databento/) must never be committed
#      or redistributed; and
#   2. evidence capture (assistant/runtime_identity.py) refuses ANY
#      untracked file, so one unignored artifact from a scheduled run
#      would silently stop the evidence cadence.
# Nothing under artifacts/ has ever been tracked; models and datasets are
# hash-verified at load instead of being version-controlled.
artifacts/

# Claude Code session transcripts and machine-local permissions -- these
# were committed by accident (Codex review, 2026-07-27: a 17MB session
# transcript and machine-specific settings.local.json were tracked). Never
# commit either; they belong outside the repo / in a personal, untracked
# config layer.
*.jsonl
.claude/settings.local.json

# Your real personal policy -- copy assistant/my_policy.example.json to
# this path and edit it. Gitignored so your own risk-tolerance edits are
# never accidentally committed or conflict with a repo update (GPT
# review, 2026-07-28).
assistant/my_policy.json
*.policy.lock
