{
  "version": "1.1.0",
  "name": "personal-paper-safe",
  "execution_mode": "paper",
  "max_position_pct": 0.05,
  "max_total_exposure_pct": 0.5,
  "max_basket_pct": 0.4,
  "max_leveraged_etf_pct": 0.2,
  "min_cash_reserve_pct": 0.1,
  "max_order_value": 5000.0,
  "max_daily_submitted_notional": 25000.0,
  "max_daily_order_count": 10,
  "max_open_orders": 5,
  "max_order_age_minutes": 30.0,
  "max_stale_price_minutes": 15.0,
  "max_slippage_pct": 1.0,
  "max_spread_pct": 0.5,
  "earnings_blackout_days": 2,
  "require_earnings_data": false,
  "allowed_sides": ["buy", "sell"],
  "allowed_order_types": ["market", "limit"],
  "allow_new_positions": false,
  "enable_strategy_proposals": false,
  "notes": "Paper trading only. Every order requires explicit user approval. New positions are disabled until a strategy clears the research promotion process."
